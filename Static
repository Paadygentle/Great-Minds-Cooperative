:root { --navy:#17324d; --green:#18794e; --light:#f4f7f9; --border:#dce4ea; --text:#1e2933; }
* { box-sizing:border-box; }
body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; color:var(--text); background:var(--light); }
.topbar { background:var(--navy); color:white; padding:14px 5%; display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap; }
.brand { font-weight:800; }
.brand span { display:inline-grid; place-items:center; width:34px; height:34px; border-radius:9px; background:#fff; color:var(--navy); margin-right:8px; }
nav { display:flex; gap:12px; flex-wrap:wrap; }
nav a { color:white; text-decoration:none; font-size:14px; opacity:.95; }
.container { max-width:1180px; margin:0 auto; padding:28px 18px 60px; }
.hero { background:white; padding:60px; border-radius:20px; box-shadow:0 8px 30px #0d243610; }
.hero h1 { max-width:760px; font-size:clamp(34px,6vw,62px); line-height:1.05; margin:10px 0 20px; }
.eyebrow { color:var(--green); font-size:12px; font-weight:800; letter-spacing:.14em; }
.page-head { display:flex; justify-content:space-between; align-items:center; gap:15px; margin-bottom:18px; }
h1,h2 { margin-top:0; }
.card,.auth-card { background:white; border:1px solid var(--border); border-radius:14px; padding:20px; margin-bottom:18px; }
.auth-card { max-width:460px; margin:50px auto; }
.grid { display:grid; gap:16px; }
.stats { grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); margin-bottom:20px; }
.stats strong { display:block; font-size:26px; margin-top:8px; }
.button { display:inline-block; border:0; border-radius:9px; background:var(--green); color:white; padding:11px 16px; text-decoration:none; cursor:pointer; font-weight:700; }
.button.small { padding:7px 10px; font-size:12px; }
form label { display:block; font-weight:700; font-size:14px; margin-bottom:14px; }
input,select { width:100%; margin-top:6px; padding:11px 12px; border:1px solid #cbd5dc; border-radius:8px; font:inherit; background:white; }
.form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 14px; }
.table-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; min-width:650px; }
th,td { text-align:left; padding:11px 10px; border-bottom:1px solid var(--border); font-size:14px; }
th { background:#f7fafb; }
.flash { padding:12px 14px; border-radius:9px; margin-bottom:15px; background:#eaf4ff; }
.flash.error { background:#fff0f0; }
.flash.success { background:#ecf9f1; }
.filter { display:flex; gap:10px; margin-bottom:18px; }
.filter select { max-width:500px; }
footer { text-align:center; padding:25px; color:#64748b; font-size:13px; }
@media(max-width:700px) {
  .topbar { align-items:flex-start; }
  nav { width:100%; }
  .hero { padding:30px 20px; }
  .form-grid { grid-template-columns:1fr; }
  .page-head { align-items:flex-start; }
}
